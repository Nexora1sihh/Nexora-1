# National Weather Intelligence Platform (NWIP) Config
PROJECT_NAME="National Weather Intelligence Platform"
PROJECT_SHORT_NAME="NWIP"
TAGLINE="Real-Time Multi-Source Weather Intelligence & Verification"
SECRET_KEY="nwip-secret-key-hackathon-2026-secure-jwt-token"

# Database Configuration (PostgreSQL / PostGIS with SQLite fallback)
DATABASE_URL="sqlite:///./nwip_weather.db"
# For PostgreSQL / PostGIS:
# DATABASE_URL="postgresql://nwip_user:nwip_password@localhost:5432/nwip_db"

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="nwip-media"

# Kafka Stream Configuration
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Demo Mode Toggles
DEMO_MODE=true
